{
    "name": "review-mode",
    "private": true,
    "type": "module",
    "scripts": {
        "bundle": "node esbuild.mjs",
        "zip": "rm -f distribution.zip && zip --recurse-paths --quiet distribution.zip dist distribution-manifest.json -x '*.map'",
        "build": "npm run bundle && npm run zip",
        "dev": "node esbuild.mjs --dev && node dev/server.mjs"
    },
    "dependencies": {
        "@veeva/vault": "https://vault-web-sdk-releases-public.s3.us-west-2.amazonaws.com/main/veeva-vault-26.2.0-release.1.3.5.tgz",
        "pdfjs-dist": "5.4.624",
        "react": "18.3.1",
        "react-dom": "18.3.1"
    },
    "devDependencies": {
        "esbuild": "0.25.0"
    }
}
